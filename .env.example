# Copy to .env.local and fill in. Never commit .env.local.
# Variables starting with NEXT_PUBLIC_ are visible in the browser. Everything else is server-only.

# ---------- Solana network ----------
# devnet (default) or mainnet-beta. Mainnet also requires NEXT_PUBLIC_ALLOW_MAINNET=true.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_ALLOW_MAINNET=false
# RPC the browser uses (wallet balances, sending trades). Public devnet works; a Helius URL is better.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# RPC the server uses (may contain a private API key). Example: https://devnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=

# ---------- App ----------
# Host (and port) users reach the app on. Signed orders and sign-in messages are bound to it.
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
# 32+ random characters for the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---------- OTC fees ----------
# Platform fee in basis points (50 = 0.5%), paid from seller proceeds.
NEXT_PUBLIC_OTC_FEE_BPS=50
# Wallet that receives OTC fees. A public key you control (NOT a private key). OTC is disabled while empty.
NEXT_PUBLIC_OTC_TREASURY=
# Optional server-side copy. If set it must equal NEXT_PUBLIC_OTC_TREASURY or settlements are refused.
OTC_TREASURY=
# Optional priority fee for settlement transactions (micro-lamports per compute unit, capped at 200000).
SETTLEMENT_CU_PRICE_MICROLAMPORTS=10000

# ---------- Supabase ----------
# Project Settings > API in the Supabase dashboard.
SUPABASE_URL=
# The service_role key. Server only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Launchpad metadata (IPFS) ----------
# Pinata JWT with pinFileToIPFS and pinJSONToIPFS permissions: https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
# Optional dedicated gateway, e.g. https://your-name.mypinata.cloud
PINATA_GATEWAY=
